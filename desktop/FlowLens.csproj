<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FlowLens</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/flowlens.ico</ApplicationIcon>
    <Version>0.8.1</Version>
    <Authors>Chuang Xiao</Authors>
    <Company>Chuang Xiao</Company>
    <Product>FlowLens</Product>
    <Description>Created by Chuang Xiao. Scientific video motion and interface analysis.</Description>
    <AssemblyTitle>FlowLens · Created by Chuang Xiao</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup><Resource Include="assets/flowlens.ico"/><Resource Include="assets/flowlens-mark.png"/></ItemGroup>
</Project>
