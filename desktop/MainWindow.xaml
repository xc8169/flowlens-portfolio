<Window x:Class="FlowLens.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:FlowLens" Icon="assets/flowlens.ico" Title="FlowLens · Created by Chuang Xiao · v0.8.1" Width="1480" Height="1000" MinWidth="1200" MinHeight="860" Background="#F3F6F6" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Margin="24,18"><Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
  <DockPanel><StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="FLOWLENS / 0.8.1" Foreground="#647982" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="About FlowLens" Click="About_Click" FontSize="11" Padding="10,5" Margin="0"/></StackPanel><TextBlock x:Name="WorkflowStatus" Text="Choose a recording" FontSize="12" Margin="0,6,0,0"/></StackPanel><StackPanel><StackPanel Orientation="Horizontal"><Image Source="assets/flowlens-mark.png" Width="38" Height="38" Margin="0,0,10,0"/><TextBlock Text="FlowLens" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Created by Chuang Xiao" FontSize="14" FontWeight="SemiBold" Foreground="#176D76" VerticalAlignment="Center" Margin="18,0,0,0"/></StackPanel><TextBlock Text="Flow pattern → interface detection or skip → droplet motion" Foreground="#647982" FontSize="12"/></StackPanel></DockPanel>
  <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer x:Name="SetupScroll" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="InputPanel">
     <TextBlock Text="01 / INPUT &amp; SETUP" FontWeight="SemiBold" FontSize="12"/>
     <TextBlock Style="{StaticResource Label}" Text="DATA SOURCE"/>
     <ComboBox x:Name="Experiment" SelectionChanged="Experiment_SelectionChanged" DisplayMemberPath="Label"/>
     <UniformGrid x:Name="ConditionPanel" Columns="2"><StackPanel><TextBlock Style="{StaticResource Label}" Text="Vm · mixture velocity"/><ComboBox x:Name="VmSelector" DisplayMemberPath="Label" SelectionChanged="Vm_SelectionChanged" Margin="0,6,9,10"/></StackPanel><StackPanel><TextBlock Style="{StaticResource Label}" Text="WC · water cut"/><ComboBox x:Name="WcSelector" DisplayMemberPath="Label" SelectionChanged="Wc_SelectionChanged" Margin="0,6,0,10"/></StackPanel></UniformGrid>
     <TextBlock x:Name="ConditionSummary" Text="Select experimental conditions." Foreground="#176D76" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,5"/>
     <Button Content="Open recording…" Click="Open_Click" HorizontalAlignment="Stretch"/>
     <TextBlock x:Name="SourceLabel" Text="Select a sample or open a recording." FontSize="11" Foreground="#647982" Margin="0,8,0,4"/>
     <Separator Margin="0,10"/>
     <TextBlock Text="FRAME SELECTION" FontWeight="SemiBold" FontSize="11"/>
     <UniformGrid Columns="2"><StackPanel><TextBlock Text="Start frame (0-based)" Style="{StaticResource Label}"/><TextBox x:Name="StartFrame" Text="0"/></StackPanel><StackPanel><TextBlock Text="Pairs to analyze" Style="{StaticResource Label}"/><TextBox x:Name="PairCount" Text="20"/></StackPanel></UniformGrid>
     <UniformGrid Columns="2"><StackPanel><TextBlock Text="Frame gap" Style="{StaticResource Label}"/><TextBox x:Name="FrameGap" Text="1"/></StackPanel><StackPanel><TextBlock Text="Acquisition FPS" Style="{StaticResource Label}"/><TextBox x:Name="Fps" Text="0"/></StackPanel></UniformGrid>
     <UniformGrid Columns="2"><StackPanel><TextBlock Text="Pair spacing (frames)" Style="{StaticResource Label}"/><TextBox x:Name="PairStep" Text="1"/></StackPanel><StackPanel><TextBlock Text="Sampling help" Style="{StaticResource Label}"/><TextBlock Text="Gap: A → B&#10;Spacing: A → next A" FontSize="10" Foreground="#647982" Margin="0,6,0,0"/></StackPanel></UniformGrid><Button Content="Preview selected frame" Click="Preview_Click"/>
     <TextBlock Text="ANALYSIS REGION" FontWeight="SemiBold" FontSize="11" Margin="0,12,0,0"/>
     <TextBlock Text="Drag on the image to select; coordinates use original pixels." FontSize="11" Foreground="#647982" Margin="0,5,0,0"/>
     <UniformGrid Columns="4"><StackPanel><TextBlock Text="X" Style="{StaticResource Label}"/><TextBox x:Name="RoiX" Text="0"/></StackPanel><StackPanel><TextBlock Text="Y" Style="{StaticResource Label}"/><TextBox x:Name="RoiY" Text="0"/></StackPanel><StackPanel><TextBlock Text="Width" Style="{StaticResource Label}"/><TextBox x:Name="RoiW" Text="320"/></StackPanel><StackPanel><TextBlock Text="Height" Style="{StaticResource Label}"/><TextBox x:Name="RoiH" Text="192"/></StackPanel></UniformGrid>
     <Button Content="Use full image" Click="ResetRoi_Click"/>
     <TextBlock Text="Farnebäck window size" Style="{StaticResource Label}"/>
     <ComboBox x:Name="WindowSize" SelectedIndex="0"><ComboBoxItem Content="15"/><ComboBoxItem Content="25"/><ComboBoxItem Content="35"/></ComboBox>
     <TextBlock Text="PHYSICAL CALIBRATION" FontWeight="SemiBold" FontSize="11"/>
     <TextBlock Text="Millimeters per pixel" Style="{StaticResource Label}"/><TextBox x:Name="Scale" Text="0.08333333333333333" ToolTip="User supplied: 50 mm pipe inner diameter across approximately 600 original-image pixels. Scale = 50 / 600 = 0.0833333 mm/pixel. Editable if imaging geometry changes."/>
     <TextBlock Text="Reference: 50 mm ID / ~600 px (approx.)" FontSize="11" Foreground="#647982" Margin="0,0,0,8"/><CheckBox x:Name="CalibrationConfirmed" Content="Enable calibrated image velocity" FontSize="11" Margin="0,0,0,10"/>
    </StackPanel></ScrollViewer><StackPanel Grid.Row="1" Margin="0,8,0,0">
    <Button x:Name="ClassifyButton" Content="1. Classify flow pattern" Click="Classify_Click" Background="#176D76" Foreground="White" FontWeight="SemiBold"/>
    <Button x:Name="DetectInterfaceButton" Content="2. Detect interface" Click="Interface_Click" FontWeight="SemiBold"/>
    <Button x:Name="AnalyzeButton" Content="3. Analyze droplet motion" Click="Analyze_Click" FontWeight="SemiBold"/>

    <Button x:Name="CancelButton" Content="Cancel processing" IsEnabled="False" Click="Cancel_Click"/>
   </StackPanel></Grid></Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="WorkspaceTabs" Background="Transparent" BorderThickness="0" SelectionChanged="WorkspaceTabs_SelectionChanged">
     <TabItem x:Name="ClassificationTab" Header="1. Flow classification" Padding="18,10"><Border Style="{StaticResource Card}" Margin="0,8,0,0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel LastChildFill="False"><TextBlock Text="FLOW PATTERN" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="ReclassifyButton" Content="Re-run classification" Click="Reclassify_Click" DockPanel.Dock="Right" Padding="10,6"/></DockPanel>
       <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,20,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Image x:Name="ClassificationImage" Stretch="Uniform"/><TextBlock x:Name="TrainingSourceText" Grid.Row="1" Foreground="#9A651C" FontSize="11" Margin="0,10,0,6"/></Grid>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="IMAGE-BASED PREDICTION" Foreground="#647982" FontSize="10"/><TextBlock x:Name="AIPredictionText" Text="Run step 1 to classify the selected range" FontSize="21" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock x:Name="ClassificationDecision" Text="Experimental model · review required" Foreground="#9A651C" Margin="0,7,0,0"/><TextBlock x:Name="ClassScoreText" FontSize="12" Foreground="#647982" Margin="0,12,0,0"/><TextBlock x:Name="KnownPatternText" FontSize="13" Margin="0,18,0,14"/><TextBlock Text="TOP MODEL SCORES (UNCALIBRATED)" FontSize="10" Foreground="#647982"/>
         <ItemsControl x:Name="RankingItems" Margin="0,7,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Label}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{Binding Score}" Grid.Column="1" FontSize="12" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <TextBlock x:Name="ValidationText" FontSize="12" Foreground="#9A651C" Margin="0,18,0,0"/>
        </StackPanel></ScrollViewer>
       </Grid>
       <Button x:Name="ContinueButton" Grid.Row="2" Content="Continue to interface detection →" Click="Continue_Click" HorizontalAlignment="Right" Background="#176D76" Foreground="White" Margin="0,15,0,0"/>
      </Grid>
     </Border></TabItem>
     <TabItem x:Name="InterfaceTab" Header="2. Interface detection" Padding="18,10"><Border Style="{StaticResource Card}" Margin="0,8,0,0"><Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False"><TextBlock x:Name="InterfacePatternText" Text="AI flow pattern: not classified" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="RedetectInterfaceButton" Content="Re-run interface detection" Click="RedetectInterface_Click" DockPanel.Dock="Right" Padding="10,6"/></DockPanel>
      <Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Background="#EDF2F3" CornerRadius="5" Margin="0,0,14,0"><Image x:Name="InterfaceImage" Stretch="Uniform"/></Border>
       <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <StackPanel><TextBlock x:Name="InterfaceModelStatus" Text="Loading bundled model…" FontSize="11" Foreground="#647982"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="Interface compute" VerticalAlignment="Center" Margin="0,0,10,0"/>
           <ComboBox x:Name="InterfaceCompute" SelectedIndex="0" Width="200" SelectionChanged="InterfaceCompute_Changed"><ComboBoxItem Content="Auto · GPU with CPU fallback"/><ComboBoxItem Content="CPU"/></ComboBox>
          </StackPanel></StackPanel>
        <TextBlock x:Name="InterfaceResultText" Grid.Row="1" Text="No saved interface prediction." FontSize="13" Margin="0,16,0,8"/>
        <Image x:Name="InterfaceTimelineImage" Grid.Row="2" Stretch="Uniform"/>
       </Grid>
      </Grid>
      <StackPanel Grid.Row="2" Margin="0,10,0,0"><Slider x:Name="InterfaceSlider" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="False" ValueChanged="InterfaceSlider_Changed"/><TextBlock x:Name="InterfaceCaption" Text="Continue starts detection for the selected range." FontSize="11" Foreground="#647982" Margin="0,5,0,0"/></StackPanel>
      <Button x:Name="InterfaceContinueButton" Grid.Row="3" Content="Continue to motion analysis →" Click="ContinueToMotion_Click" HorizontalAlignment="Right" Background="#176D76" Foreground="White" Margin="0,14,0,0"/>
     </Grid></Border></TabItem>
     <TabItem x:Name="MotionTab" Header="3. Droplet motion" Padding="18,10"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="0,8,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="104"/><RowDefinition Height="12"/><RowDefinition Height="320"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel LastChildFill="False" Margin="0,0,0,8"><TextBlock x:Name="PatternSummary" Text="Flow classification has not been run" FontSize="12" Foreground="#647982" VerticalAlignment="Center"/><CheckBox x:Name="InterfaceOverlayCheck" Content="Interface overlay" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0" Checked="InterfaceOverlay_Changed" Unchecked="InterfaceOverlay_Changed"/><Button x:Name="ReanalyzeButton" Content="Re-run motion" Click="Reanalyze_Click" DockPanel.Dock="Right" Padding="10,6"/></DockPanel>
      <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="HORIZONTAL MOTION · PAIR" FontSize="10" Foreground="#647982"/><TextBlock x:Name="MotionValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="+ rightward · − leftward" FontSize="10" Foreground="#647982"/></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="IMAGE VELOCITY · PAIR" FontSize="10" Foreground="#647982"/><TextBlock x:Name="VelocityValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Approximate pipe calibration" FontSize="10" Foreground="#647982"/></StackPanel></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="TEXTURE COVERAGE · PAIR" FontSize="10" Foreground="#647982"/><TextBlock x:Name="CoverageValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock Text="Image detail · not confidence" FontSize="10" Foreground="#647982"/></StackPanel></Border>
      </Grid>
      <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="VideoHeading" Text="VIDEO / SELECT REGION" FontSize="11" FontWeight="SemiBold"/>
        <Grid x:Name="ImageHost" Grid.Row="1" Background="#EDF2F3" ClipToBounds="True" Margin="0,8,0,0" SizeChanged="ImageHost_SizeChanged"><Image x:Name="VideoImage" Stretch="Uniform"/><Canvas x:Name="SelectionCanvas" Background="Transparent" MouseLeftButtonDown="Region_Down" MouseMove="Region_Move" MouseLeftButtonUp="Region_Up"><Rectangle x:Name="SelectionRect" Stroke="#1AA5A5" StrokeThickness="2" Fill="#101AA5A5" IsHitTestVisible="False" Visibility="Collapsed"/></Canvas></Grid>
        <TextBlock x:Name="VideoFrameInfo" Grid.Row="2" Text="Drag to set the analysis region" FontSize="10" Foreground="#647982" Margin="0,6,0,0"/>
       </Grid></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10" Margin="0,0,8,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="VectorHeading" Text="MOTION VECTORS" FontSize="11" FontWeight="SemiBold"/><Image x:Name="VectorImage" Grid.Row="1" Stretch="Uniform" Margin="0,8,0,0"/><TextBlock Text="Thin yellow arrows · 8× display scale" Grid.Row="2" FontSize="10" Foreground="#647982" Margin="0,6,0,0"/></Grid></Border>
       <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel LastChildFill="False"><TextBlock Text="VELOCITY PROFILE" FontSize="11" FontWeight="SemiBold"/><CheckBox x:Name="CompareReference" Content="Reference" FontSize="10" IsChecked="False" DockPanel.Dock="Right" Checked="Reference_Changed" Unchecked="Reference_Changed"/></DockPanel><local:VelocityProfileChart x:Name="PairChart" Grid.Row="1"/></Grid></Border>
      </Grid>
      <Grid Grid.Row="4" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel LastChildFill="False"><Button x:Name="PlayButton" Content="▶ Play" Click="Play_Click" Padding="12,5"/><Button x:Name="PreviousPairButton" Content="‹ Pair" Click="PreviousPair_Click" Padding="8,5"/><Button x:Name="NextPairButton" Content="Pair ›" Click="NextPair_Click" Padding="8,5"/><ComboBox x:Name="PlaybackSpeed" Width="85" SelectedIndex="1" SelectionChanged="Speed_Changed" Margin="2,3,8,3"><ComboBoxItem Content="0.05×" Tag="0.05"/><ComboBoxItem Content="0.1×" Tag="0.1"/><ComboBoxItem Content="0.25×" Tag="0.25"/><ComboBoxItem Content="1×" Tag="1"/></ComboBox><CheckBox x:Name="LoopPlayback" Content="Loop" IsChecked="True" VerticalAlignment="Center"/><Button x:Name="ShowFrameBButton" Content="A / B" ToolTip="Toggle the raw video frame between A and B of this pair" Click="ShowFrameB_Click" Padding="8,5"/><TextBlock x:Name="PairInfo" DockPanel.Dock="Right" FontSize="11" Foreground="#647982" VerticalAlignment="Center"/></DockPanel>
       <Slider x:Name="PairSlider" Grid.Row="1" Minimum="0" Maximum="1" IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="False" ValueChanged="PairSlider_Changed" VerticalAlignment="Center"/>
       <TextBlock x:Name="PairCaption" Grid.Row="2" Text="Run motion analysis once; all three views stay synchronized." FontSize="10" Foreground="#647982"/>
      </Grid>
      <Expander x:Name="TrendsExpander" Grid.Row="5" Header="Time trends" Margin="0,8,0,0" IsEnabled="False"><TabControl Height="240" Margin="0,6,0,0"><TabItem Header="Profile over time"><Image x:Name="TimelineImage" Stretch="Uniform"/></TabItem><TabItem Header="Median velocity"><Image x:Name="TraceImage" Stretch="Uniform"/></TabItem></TabControl></Expander>
     </Grid></ScrollViewer></TabItem>
    </TabControl>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RESULTS &amp; MEASUREMENT NOTES" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="Notes" Text="Classify flow, continue to interface detection (or skip), then continue to motion analysis. Results stay saved." FontSize="11" Foreground="#647982" Margin="0,7,12,0"/></StackPanel><StackPanel Grid.Column="1"><Button x:Name="ExportButton" Content="Export saved results…" Click="Export_Click" Padding="10,6" IsEnabled="False"/><Button x:Name="ResultsButton" Content="Open results folder" Click="Results_Click" Padding="10,6" IsEnabled="False"/><Button Content="Measurement help" Click="MetricsHelp_Click" FontSize="10" Padding="8,4"/></StackPanel></Grid></Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="5"/></Grid.RowDefinitions><TextBlock x:Name="Status" Text="Ready" FontSize="12" Foreground="#647982" VerticalAlignment="Center"/><ProgressBar x:Name="Progress" Grid.Row="1" Maximum="100" Foreground="#176D76" Background="#DDE7E9" BorderThickness="0"/></Grid>
 </Grid>
</Window>
